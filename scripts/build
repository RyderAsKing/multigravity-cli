#!/usr/bin/env bash
set -Eeuo pipefail
export LC_ALL=C

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
VERSION=${VERSION:-0.0.0-dev}
OUTPUT=${OUTPUT:-$ROOT/dist/multigravity}

[[ "$VERSION" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-dev)?$ ]] || {
  printf 'invalid VERSION: %s\n' "$VERSION" >&2
  exit 2
}
modules=(
  src/bootstrap.sh
  src/core/errors.sh src/core/config.sh src/core/paths.sh src/core/validation.sh src/core/locking.sh
  src/platform/linux.sh src/platform/antigravity.sh
  src/profile/layout.sh src/profile/lifecycle.sh src/profile/launch.sh
  src/features/reporting.sh
  src/cli/usage.sh src/cli/parse.sh src/cli/dispatch.sh
)

mkdir -p -- "$(dirname -- "$OUTPUT")"
tmp="$OUTPUT.tmp"
trap 'rm -f -- "$tmp"' EXIT
{
  printf '%s\n' '#!/usr/bin/env bash' '# Generated deterministically by scripts/build. Do not edit.' 'set -Eeuo pipefail'
  printf 'MG_VERSION=%q\n' "$VERSION"
  for module in "${modules[@]}"; do
    printf '\n# module: %s\n' "$module"
    sed '1{/^#!\/usr\/bin\/env bash$/d;}; s/@MG_VERSION@/'"$VERSION"'/g' "$ROOT/$module"
  done
  printf '\n%s\n' 'mg_linux_require_base_tools' 'mg_main "$@"'
} >"$tmp"

duplicates=$(grep -hE '^mg_[a-zA-Z0-9_]+\(\)' "${modules[@]/#/$ROOT/}" | cut -d'(' -f1 | sort | uniq -d)
[[ -z "$duplicates" ]] || {
  printf 'duplicate functions:\n%s\n' "$duplicates" >&2
  exit 1
}
! grep -q '@MG_VERSION@' "$tmp" || {
  printf 'unresolved build placeholder\n' >&2
  exit 1
}
bash -n "$tmp"
chmod 755 "$tmp"
mv -f -- "$tmp" "$OUTPUT"
trap - EXIT
printf '%s\n' "$OUTPUT"
