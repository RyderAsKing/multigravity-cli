#!/usr/bin/env bash
set -Eeuo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
forbidden=' (multigravity|multigravity\.ps1|install\.sh|install\.ps1|uninstall\.sh|uninstall\.ps1|icon\.icns|assets/multigravity-logo\.jpg)$'

if git -C "$root" rev-list HEAD --objects | grep -Eq "$forbidden"; then
  printf '%s\n' 'release blocked: inherited implementation or asset paths remain reachable in Git history' >&2
  printf '%s\n' 'publish from a fresh/orphan history containing only the new implementation' >&2
  exit 1
fi
